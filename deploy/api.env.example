# Environment of the Stallfunk API. Installed as /etc/reiterhof/api.env
# (root:reiterhof, mode 0640) by provision.sh, which replaces CHANGE_ME_DB_PASSWORD.
# systemd EnvironmentFile syntax: KEY=value, no "export", no shell expansion.

# Listen on loopback only; Caddy terminates TLS and proxies to this address.
REITERHOF_ADDR=127.0.0.1:8080

# PostgreSQL connection (role and database are created by provision.sh).
# The password must be URL-safe ([A-Za-z0-9._~-]).
REITERHOF_DATABASE_URL=postgres://reiterhof:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/reiterhof?sslmode=disable

# Directory for uploaded photos and documents (internal/files). Must match ReadWritePaths in
# reiterhof-api.service and the path backed up by backup.sh.
REITERHOF_UPLOAD_DIR=/var/lib/reiterhof/uploads

# Authentication (see docs/architecture.md, "Authentication and roles").
# Public base URL of the API, used for the https fallback link in login mails and the link
# in the mail to parents (parental consent). Public URL of the web app: pages and mails link
# its privacy text (<URL>/legal/privacy).
# Secret key for the stored 6-digit login codes (HMAC) and, derived from it, for the
# short-lived download links. Generate with: openssl rand -hex 32
#REITERHOF_LOGIN_CODE_KEY=
#REITERHOF_PUBLIC_URL=https://api.example.org
#REITERHOF_WEB_URL=https://example.org
# SMTP for magic-link mails. Without REITERHOF_SMTP_HOST the mail is only logged.
# Production uses Resend (see docs/auth-setup.md); the password is a Resend API key.
#REITERHOF_SMTP_HOST=smtp.resend.com
#REITERHOF_SMTP_PORT=587
#REITERHOF_SMTP_USER=resend
#REITERHOF_SMTP_PASSWORD=re_...
#REITERHOF_SMTP_FROM=Stallfunk <login@stallfunk.de>
# Accepted "aud" values of the ID tokens (comma separated).
#REITERHOF_GOOGLE_CLIENT_IDS=
#REITERHOF_APPLE_CLIENT_IDS=de.flusinerd.stallfunk
# Never set REITERHOF_DEV_LOGIN=true in production.

# Native push: the API sends to Apple (APNs) and Google (FCM) directly, no relay in between.
# Both credentials are files in /etc/reiterhof (root:reiterhof 0640). A platform without
# credentials is skipped at send time (log line); the other one still works.
# APNs: Apple Developer, Certificates, Identifiers & Profiles, Keys, "Apple Push Notifications
# service (APNs)". Download the .p8 once (Apple never shows it again), note the key ID and the team ID.
#REITERHOF_APNS_KEY_FILE=/etc/reiterhof/apns.p8
#REITERHOF_APNS_KEY_ID=ABC123DEFG
#REITERHOF_APNS_TEAM_ID=TEAM123456
# Bundle identifier (default de.flusinerd.stallfunk). Set REITERHOF_APNS_SANDBOX=true for builds
# from Xcode (development provisioning); store and TestFlight builds use production.
#REITERHOF_APNS_TOPIC=de.flusinerd.stallfunk
#REITERHOF_APNS_SANDBOX=false
# FCM: Firebase console, Project settings, Service accounts, "Generate new private key" (JSON).
#REITERHOF_FCM_SERVICE_ACCOUNT_FILE=/etc/reiterhof/fcm-service-account.json

# Web Push for the PWA (iPhone via Safari "Zum Home-Bildschirm", other browsers). Without the keys
# web push is off (native devices still get APNs/FCM push). Generate a pair once, on any machine
# with Go, in the repository:  cd backend && go run ./cmd/vapidkeys -subject mailto:you@example.org
# Keep the private key secret and never change it later (existing browser subscriptions would break).
#REITERHOF_VAPID_PUBLIC_KEY=
#REITERHOF_VAPID_PRIVATE_KEY=
#REITERHOF_VAPID_SUBJECT=mailto:admin@example.org

# AI week plan (JAN-89): Mistral AI, Studio, API Keys. Without a key the rules plan the week alone.
# Before setting it: Admin Console, API, Privacy: "Allow the use of your API calls to train Mistral's
# AI models" off and "Enable Labs models" off (docs/legal/avv-checkliste.md, Teil 1).
#REITERHOF_MISTRAL_API_KEY=
# Optional, default mistral-large-2512 (needs a paid API tier; on the free tier it answers 403
# tier_not_allowed, use ministral-14b-2512 there). Pin a version: a "-latest" alias may not be
# enabled (HTTP 429 rate_limited). Labs models are refused.
#REITERHOF_MISTRAL_MODEL=ministral-14b-2512
